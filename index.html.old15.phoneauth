// ----------------------------------------------------
// BATTERY CONSTANTS
// ----------------------------------------------------

// Maximum battery energy allowed for this system.
// 100 Ah LiFePO4 battery.
// Usable/chargeable energy = 1,152 Wh.

const MAX_BATTERY_WH = 1152;
const MAX_USABLE_SOC = 90;

// ----------------------------------------------------
// WATER PUMP ENERGY CONSUMPTION
// ----------------------------------------------------

// Pump power consumption
const PUMP_POWER_W = 230;

// Typical pump operation per day
const PUMP_RUNTIME_MIN_PER_DAY = 20;

// Calculate daily pump energy consumption
const PUMP_DAILY_WH =
    PUMP_POWER_W *
    (PUMP_RUNTIME_MIN_PER_DAY / 60);

// Water produced by pump during one 20-minute operation
const PUMP_WATER_LITRES_PER_RUN = 600;

//const pumpRemainingDays =
//    currentBatteryWh / PUMP_DAILY_WH;

	

// ----------------------------------------------------
// SINGAPORE DATE
// ----------------------------------------------------

function getSingaporeDate() {

    const parts =
        new Intl.DateTimeFormat("en-GB", {

            timeZone: "Asia/Singapore",

            year: "numeric",

            month: "2-digit",

            day: "2-digit"

        }).formatToParts(new Date());


    const values =
        Object.fromEntries(

            parts
                .filter(part => part.type !== "literal")
                .map(part => [part.type, part.value])

        );


    return `${values.year}-${values.month}-${values.day}`;
}


// ----------------------------------------------------
// HARVEST CHART
// ----------------------------------------------------

function redrawHarvestChart(history) {

    const points =
        Object.entries(history || {})

            .map(([time, wh]) => ({

                time,

                wh: Number(wh)

            }))

            .filter(point =>
                Number.isFinite(point.wh)
            )

            .sort((a, b) =>
                a.time.localeCompare(b.time)
            );


    const labels =
        points.map(point => point.time);


    const values =
        points.map(point => point.wh);


    if (!harvestChart) {

        harvestChart =
            new Chart(

                document.getElementById("harvestChart"),

                {

                    type: "line",

                    data: {

                        labels,

                        datasets: [{

                            label:
                                "Accumulated Watt Hour",

                            data:
                                values,

                            borderColor:
                                "#198754",

                            backgroundColor:
                                "rgba(25, 135, 84, 0.12)",

                            fill: true,

                            tension: 0.25,

                            pointRadius: 2,

                            pointHoverRadius: 5

                        }]

                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        animation: {

                            duration: 250

                        },

                        scales: {

                            x: {

                                title: {

                                    display: true,

                                    text:
                                        "Time (one-minute samples)"

                                }

                            },

                            y: {

                                beginAtZero: true,

                                title: {

                                    display: true,

                                    text:
                                        "Accumulated Watt Hour"

                                }

                            }

                        }

                    }

                }

            );

        return;
    }


    harvestChart.data.labels =
        labels;

    harvestChart.data.datasets[0].data =
        values;

    harvestChart.update();

}


// ----------------------------------------------------
// SUBSCRIBE TO HARVEST HISTORY
// ----------------------------------------------------

function subscribeHarvestChart() {

    const today =
        getSingaporeDate();


    if (today === activeHistoryDate) {

        return;

    }


    if (stopHarvestChart) {

        stopHarvestChart();

    }


    activeHistoryDate =
        today;


    stopHarvestChart =

        onValue(

            ref(db, `harvest_history/${today}`),

            snapshot => {

                redrawHarvestChart(
                    snapshot.val()
                );

            },

            error => {

                console.error(
                    "Harvest history listener error:",
                    error
                );

            }

        );

}


