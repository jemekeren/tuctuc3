async function updateData() {

    try {

        subscribeHarvestChart();


        // ------------------------------------------------
        // RELAY STATUS
        // ------------------------------------------------

        let snapshot =
            await get(
                ref(db, "status_switch")
            );


        if (snapshot.exists()) {

            const v =
                String(snapshot.val())
                    .trim()
                    .toLowerCase();


            const el =
                document.getElementById(
                    "relayStatus"
                );


            if (v === "relay_on") {

                el.innerHTML =
                    '<span class="green">RELAY ON</span>';

            }

            else if (v === "relay_off") {

                el.innerHTML =
                    '<span class="red">RELAY OFF</span>';

            }

            else {

                el.innerText =
                    "--";

            }

        }


// ------------------------------------------------
// AC VOLTAGE
// ------------------------------------------------
snapshot = await get(ref(db, "invertervolt"));

const acVoltageElement = document.getElementById("acVoltage");

if (snapshot.exists()) {
    const acVoltageValue = snapshot.val();
    acVoltageElement.innerText = acVoltageValue;
    
    // Parse the value into a float for grid threshold monitoring
    const numericAcVoltage = parseFloat(acVoltageValue);
    
    if (!isNaN(numericAcVoltage)) {
        // merah warning if grid pressure drops too low (e.g., brownout / dropout below 210V)
        if (numericAcVoltage < 210) {
            acVoltageElement.classList.add("merah");
            acVoltageElement.classList.remove("hijau");
        } else {
            acVoltageElement.classList.add("hijau");
            acVoltageElement.classList.remove("merah");
        }
    }
} else {
    acVoltageElement.innerText = "N/A";
    acVoltageElement.classList.remove("hijau", "merah");
}


        // ------------------------------------------------
        // BATTERY VOLTAGE -> SOC
        // ------------------------------------------------

        snapshot =
            await get(
                ref(db, "battvol")
            );


        const batterySocEl =
            document.getElementById(
                "batterySoc"
            );


        // SOC is declared outside the voltage block
        // so it can also be used for the Wh calculation.

        let soc = NaN;


        if (snapshot.exists()) {

            const voltage =
                Number(snapshot.val());


            if (Number.isFinite(voltage)) {


                // ----------------------------------------
                // VOLTAGE TO SOC TABLE
                // ----------------------------------------

                if (voltage >= 13.6) {

                    // 13.6 V = 100%
                    soc = 100;

                }

                else if (voltage >= 13.4) {

                    // 13.4 V = 90%
                    // 13.6 V = 100%

                    soc =
                        90 +
                        ((voltage - 13.4) / 0.2) *
                        10;

                }

                else if (voltage >= 13.3) {

                    // 13.3 V = 80%
                    // 13.4 V = 90%

                    soc =
                        80 +
                        ((voltage - 13.3) / 0.1) *
                        10;

                }

                else if (voltage >= 13.2) {

                    // 13.2 V = 70%
                    // 13.3 V = 80%

                    soc =
                        70 +
                        ((voltage - 13.2) / 0.1) *
                        10;

                }

                else if (voltage >= 13.1) {

                    // 13.1 V = 60%
                    // 13.2 V = 70%

                    soc =
                        60 +
                        ((voltage - 13.1) / 0.1) *
                        10;

                }

                else if (voltage >= 13.0) {

                    // 13.0 V = 50%
                    // 13.1 V = 60%

                    soc =
                        50 +
                        ((voltage - 13.0) / 0.1) *
                        10;

                }

                else if (voltage >= 12.9) {

                    // 12.9 V = 30%
                    // 13.0 V = 50%

                    soc =
                        30 +
                        ((voltage - 12.9) / 0.1) *
                        20;

                }

                else if (voltage >= 12.8) {

                    // 12.8 V = 20%
                    // 12.9 V = 30%

                    soc =
                        20 +
                        ((voltage - 12.8) / 0.1) *
                        10;

                }

                else if (voltage >= 12.0) {

                    // 12.0 V = 10%
                    // 12.8 V = 20%

                    soc =
                        10 +
                        ((voltage - 12.0) / 0.8) *
                        10;

                }

                else if (voltage >= 10.0) {

                    // 10.0 V = 0%
                    // 12.0 V = 10%

                    soc =
                        ((voltage - 10.0) / 2.0) *
                        10;

                }

                else {

                    soc = 0;

                }


                // Keep SOC between 0 and 100

                soc =
                    Math.max(
                        0,
                        Math.min(100, soc)
                    );


                // Whole percentage

                soc =
                    Math.round(soc);


                // Display SOC

                batterySocEl.innerText =
                    `${soc}%`;


                // Less than 10% = red
                // Otherwise = green

                batterySocEl.classList.remove(
                    "green",
                    "red"
                );


                batterySocEl.classList.add(
                    soc < 10
                    ? "red"
                    : "green"
                );

            }

            else {

                batterySocEl.innerText =
                    "N/A%";

                batterySocEl.classList.remove(
                    "green",
                    "red"
                );

            }

        }

        else {

            batterySocEl.innerText =
                "N/A%";

            batterySocEl.classList.remove(
                "green",
                "red"
            );

        }


        // ------------------------------------------------
        // DC BATTERY VOLTAGE
        // ------------------------------------------------


snapshot = await get(ref(db, "battvol"));

const dcVoltageElement = document.getElementById("dcVoltage");

if (snapshot.exists()) {
    const voltageValue = snapshot.val();
    dcVoltageElement.innerText = voltageValue;
    
    // Parse to a number for comparison (handles strings like "12.5" safely)
    const numericVoltage = parseFloat(voltageValue);
    
    if (!isNaN(numericVoltage)) {
        if (numericVoltage < 12.8) {
            dcVoltageElement.classList.add("merah");
            dcVoltageElement.classList.remove("hijau");
