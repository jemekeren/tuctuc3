            );


        document.getElementById(
            "cpuUsage"
        ).innerText =

            snapshot.exists()
            ? snapshot.val()
            : "--";


        // ------------------------------------------------
        // MEMORY
        // ------------------------------------------------

        snapshot =
            await get(
                ref(db, "mem")
            );


        document.getElementById(
            "memUsage"
        ).innerText =

            snapshot.exists()
            ? snapshot.val()
            : "--";


        // ------------------------------------------------
        // UPTIME
        // ------------------------------------------------

        snapshot =
            await get(
                ref(db, "uptime")
            );


        document.getElementById(
            "uptime"
        ).innerText =

            snapshot.exists()
            ? snapshot.val()
            : "--";


        // ------------------------------------------------
        // SOLAR HARVEST
        // ------------------------------------------------

        snapshot =
            await get(
                ref(db, "harvest")
            );


        const solarHarvest =
            snapshot.exists()
            ? Number(snapshot.val())
            : NaN;


        // Display harvested Wh

        document.getElementById(
            "solarHarvest"
        ).textContent =

            Number.isFinite(solarHarvest)

            ? `${solarHarvest.toFixed(3)} Watt Hour`

            : "N/A Watt Hour";


        // ------------------------------------------------
        // BATTERY CHARGE REMAINING TIME
        // ------------------------------------------------

        const batteryChargeTimeEl =
            document.getElementById(
                "batteryChargeTime"
            );


        if (
            Number.isFinite(soc) &&
            Number.isFinite(solarHarvest) &&
            solarHarvest > 0
        ) {


// Current battery energy
const currentBatteryWh = MAX_BATTERY_WH * (soc / MAX_USABLE_SOC);	    

// ------------------------------------------------
// BATTERY CAPACITY AND PUMP REMAINING DAYS
// ------------------------------------------------



const batteryCapacityEl =
    document.getElementById("batteryCapacity");

const batteryRemainingDaysEl =
    document.getElementById("batteryRemainingDays");

// Display current battery capacity
batteryCapacityEl.innerText =
    `Battery Capacity: ${currentBatteryWh.toFixed(1)} Wh`;

// Calculate how many days the battery can run the pump
const pumpRemainingDays =
    currentBatteryWh / PUMP_DAILY_WH;

// ------------------------------------------------
// CALCULATE REMAINING WATER PRODUCTION
// ------------------------------------------------

const batteryWaterLitresEl =
    document.getElementById("batteryWaterLitres");

// Number of complete 20-minute pump runs available
const pumpRunsRemaining =
    currentBatteryWh / PUMP_DAILY_WH;

// Each 20-minute run produces 600 litres
const remainingWaterLitres =
    pumpRunsRemaining *
    PUMP_WATER_LITRES_PER_RUN;

// Display remaining water production
batteryWaterLitresEl.innerText =
    `Water Production: ${Math.floor(remainingWaterLitres).toLocaleString()} litres`;

// Same warning state as pump runtime
batteryWaterLitresEl.classList.remove(
    "green",
    "red"
);

batteryWaterLitresEl.classList.add(
    pumpRemainingDays <= 3
        ? "red"
        : "green"
);

// Display remaining pump days
batteryRemainingDaysEl.innerText =
    `Pump Runtime: ${pumpRemainingDays.toFixed(1)} days`;

// ------------------------------------------------
// COLOR WARNING
// <= 3 days = RED
// > 3 days = GREEN
// ------------------------------------------------

batteryRemainingDaysEl.classList.remove(
    "green",
    "red"
);

batteryRemainingDaysEl.classList.add(
    pumpRemainingDays <= 3
        ? "red"
        : "green"
);




            // Energy still required

            const remainingWh =
                Math.max(
                    0,
                    MAX_BATTERY_WH -
                    currentBatteryWh
                );


            // --------------------------------------------
            // FULLY CHARGED
            // --------------------------------------------

            if (
                remainingWh <= 0 ||
                soc >= 	MAX_USABLE_SOC
            ) {

                batteryChargeTimeEl.innerText =
                    "Fully Charged";


                batteryChargeTimeEl.classList.remove(
                    "green",
                    "red"
                );


                batteryChargeTimeEl.classList.add(
                    "green"
                );

            }


            // --------------------------------------------
            // STILL CHARGING
            // --------------------------------------------

            else {

                const remainingDays =
                    remainingWh /
                    solarHarvest;


                batteryChargeTimeEl.innerText =
                    `${remainingDays.toFixed(2)} days`;


                batteryChargeTimeEl.classList.remove(
                    "green",
                    "red"
                );


                batteryChargeTimeEl.classList.add(
                    "green"
                );

            }

        }


        // ------------------------------------------------
        // INVALID HARVEST
        // ------------------------------------------------

        else if (
            Number.isFinite(soc) &&
            soc >= 100
        ) {

            batteryChargeTimeEl.innerText =
                "Fully Charged";


            batteryChargeTimeEl.classList.remove(
                "green",
                "red"
            );


            batteryChargeTimeEl.classList.add(
                "green"
            );

        }


        else {

            batteryChargeTimeEl.innerText =
                "N/A";


            batteryChargeTimeEl.classList.remove(
                "green",
                "red"
            );

        }

    }

    catch (err) {

        console.error(
            "Polling Error:",
            err
        );

    }

}


// ----------------------------------------------------
// AUTH STATE LISTENER
// ----------------------------------------------------

onAuthStateChanged(
    auth,
    (user) => {

        if (user) {

            // 🆕 CHANGED: Show phoneNumber instead of email
            document.getElementById(
                "status"
            ).innerText =
                "Logged in: " +
                user.phoneNumber;

            document.getElementById(
                "loginBox"
            ).style.display =
                "none";

            document.getElementById(
                "dashboard"
            ).style.display =
                "block";

            updateData();

            if (!pollTimer) {

                pollTimer =
                    setInterval(
                        updateData,
                        2000
                    );

            }

        }

        else {

            document.getElementById(
                "status"
            ).innerText =
                "Not logged in";

            document.getElementById(
                "loginBox"
            ).style.display =
                "block";

            // 🆕 ADDED: Reset the step screens back to the phone input step
            document.getElementById(
                "phoneStep"
            ).style.display =
                "block";

            document.getElementById(
                "verificationStep"
            ).style.display =
                "none";

            // 🆕 ADDED: Clear out whatever text was left in the input boxes
            document.getElementById(
                "phoneNumber"
            ).value = "";

            document.getElementById(
                "verificationCode"
            ).value = "";


            document.getElementById(
                "dashboard"
            ).style.display =
                "none";


            // Flush application session states

            conversationHistory = [];

            currentSessionUser = null;


            if (pollTimer) {

                clearInterval(
                    pollTimer
                );

                pollTimer = null;

            }


            // Stop Firebase harvest listener

            if (stopHarvestChart) {

                stopHarvestChart();

                stopHarvestChart = null;

            }


            activeHistoryDate = "";


            // Destroy Chart.js chart

            if (harvestChart) {

                harvestChart.destroy();

                harvestChart = null;

            }

        }

    }
);



</script>

</body>
</html>

