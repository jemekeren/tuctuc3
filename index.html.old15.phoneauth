// ----------------------------------------------------
// POWER AI
// ----------------------------------------------------

document
    .getElementById("sendBtn")
    .addEventListener("click", async () => {

        const input =
            document.getElementById("chatInput");

        const chatBox =
            document.getElementById("chatBox");


        const userText =
            input.value.trim();


        if (!userText) return;


        chatBox.innerHTML +=
            `<div><b>You:</b> ${userText}</div>`;


        input.value = "";


        if (waitingForAI) return;


        waitingForAI = true;


        document
            .getElementById("sendBtn")
            .disabled = true;


        try {

            const [

                snapInverter,

                snapBatt,

                snapSolarVolt,

                snapSolarCur,

                snapCpu,

                snapMem

            ] = await Promise.all([

                get(ref(db, "invertervolt")),

                get(ref(db, "battvol")),

                get(ref(db, "solarvolt")),

                get(ref(db, "solarcur")),

                get(ref(db, "cpu")),

                get(ref(db, "mem"))

            ]);


            const telemetryPayload = {

                invertervolt:
                    snapInverter.exists()
                    ? snapInverter.val()
                    : "N/A",

                battvol:
                    snapBatt.exists()
                    ? snapBatt.val()
                    : "missing",

                solarvolt:
                    snapSolarVolt.exists()
                    ? snapSolarVolt.val()
                    : "N/A",

                solarcur:
                    snapSolarCur.exists()
                    ? snapSolarCur.val()
                    : "N/A",

                cpu:
                    snapCpu.exists()
                    ? snapCpu.val()
                    : "--",

                mem:
                    snapMem.exists()
                    ? snapMem.val()
                    : "--"

            };


            const thinking =
                document.createElement("div");


            thinking.id =
                "thinking";


            thinking.innerHTML =
                "<b>AI:</b> <i>Thinking...</i>";


            chatBox.appendChild(
                thinking
            );


            chatBox.scrollTop =
                chatBox.scrollHeight;


            const ai =
                await askHF(

                    userText,

                    conversationHistory,

                    currentSessionUser,

                    telemetryPayload

                );


            thinking.remove();


            const aiRow =
                document.createElement("div");


            const label =
                document.createElement("b");


            label.textContent =
                "AI: ";


            const span =
                document.createElement("span");


            aiRow.appendChild(label);

            aiRow.appendChild(span);

            chatBox.appendChild(aiRow);


            await typeWriter(
                span,
                ai.reply
            );


            if (
                ai.userName &&
                ai.userName !== "Unknown User"
            ) {

                currentSessionUser =
                    ai.userName;

            }


            conversationHistory.push({

                role: "user",

                content: userText

            });


            conversationHistory.push({

                role: "assistant",

                content: ai.reply

            });


            if (
                conversationHistory.length > 10
            ) {

                conversationHistory.splice(0, 2);

            }


            if (
                ai.intent === "control"
            ) {

                if (
                    ai.command === "relay"
                ) {

                    if (
                        ai.argument === "on"
                    ) {

                        await set(
                            ref(db, "command_switch"),
                            "0"
                        );

                    }

                    else if (
                        ai.argument === "off"
                    ) {

                        await set(
                            ref(db, "command_switch"),
                            "1"
                        );

                    }

                }

            }


            chatBox.scrollTop =
                chatBox.scrollHeight;


            waitingForAI = false;

            document
                .getElementById("sendBtn")
                .disabled = false;


        }

        catch (err) {

            waitingForAI = false;

            document
                .getElementById("sendBtn")
                .disabled = false;


            chatBox.innerHTML +=
                `<div><b>AI:</b> Error: ${err.message}</div>`;


            chatBox.scrollTop =
                chatBox.scrollHeight;

        }

    });


// ----------------------------------------------------
// TYPEWRITER
// ----------------------------------------------------

async function typeWriter(element, text) {

    element.textContent = "";


    let i = 0;


    while (i < text.length) {

        const chunk =
            Math.floor(Math.random() * 4) + 1;


        element.textContent +=
            text.slice(i, i + chunk);


        i += chunk;


        element.parentElement.parentElement.scrollTop =
            element.parentElement.parentElement.scrollHeight;


        let delay =
            18 + Math.random() * 40;


        if (
            /[.,!?]/.test(text[i - 1])
        ) {

            delay += 180;

        }


        await new Promise(
            r => setTimeout(r, delay)
        );

    }

}


// ----------------------------------------------------
// AI API
// ----------------------------------------------------

async function askHF(
    prompt,
    history,
    userName,
    telemetry
) {

    const user =
        auth.currentUser;


    if (!user) {

        throw new Error(
            "Please sign in before using Power AI."
        );

    }


    const idToken =
        await user.getIdToken(true);


    const res =
        await fetch(
            "/api/chat",
            {

                method: "POST",

                headers: {

                    "Content-Type":
                        "application/json",

                    "Authorization":
                        `Bearer ${idToken}`

                },

                body: JSON.stringify({

                    message: prompt,

                    history,

                    userName,

                    telemetry

                })

            }
        );


    const data =
        await res.json();


    if (!res.ok) {

        throw new Error(
            data.error ||
            "Chat request failed"
        );

    }


    return data;

}


